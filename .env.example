# Copy to .env.local. Not needed in development (the dev server proxies /api to the backend).
#
# Development proxy target (default http://localhost:8000):
# VITE_PROXY_TARGET=http://localhost:8000
#
# Production: full URL of your deployed backend (no trailing slash). Baked in at build time.
# VITE_API_URL=https://api.your-domain.com
